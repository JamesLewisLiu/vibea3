# Bootstrap
VIBEA3_ADMIN_TOKEN=change-me
VIBEA3_LISTEN=127.0.0.1:5000
VIBEA3_MODULE_DIR=modules-bin
VIBEA3_DATA_DIR=data
VIBEA3_INFINITE_EACOIN=true
# VIBEA3_BUILD_MODULES=false

# Persistence
MONGODB_URI=mongodb://172.29.14.146:27017
MONGODB_DATABASE=vibea3

# Logging: compact, pretty, or json
VIBEA3_LOG_FORMAT=pretty
# Add vibea3::rpc::packet=debug for decoded input/output packet logging.
RUST_LOG=vibea3_server=info,vibea3=info,tower_http=info
